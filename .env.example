# --- LDA (Leitura de Arquivos) Environment Configuration ---

# App
PROJECT_NAME="LDA - Leitura de Arquivos"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="insecure-dev-secret-key-change-in-production"

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="lda_user"
POSTGRES_PASSWORD="lda_password"
POSTGRES_DB="lda_db"
DATABASE_URL="postgresql+asyncpg://lda_user:lda_password@localhost:5432/lda_db"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# LLM Providers (Configure pelo menos uma)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Embeddings & Reranking
EMBEDDING_MODEL="text-embedding-3-small"
RERANKER_PROVIDER="cohere" # ou 'local-bge'
COHERE_API_KEY=""

# Document Storage
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=50

# Langfuse Observability (Opcional)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

